# Copy to .env (.env.local) for local dev. Every value is required except the optional ones and no defaults in code.
# The one base domain: a bare lowercase host name (no scheme, port or path). Every host derives from it: DOMAIN, api./id./admin./exercises.DOMAIN,
# event sites <tag>.DOMAIN, cookies on DOMAIN. There are no per-host settings.
NEXT_PUBLIC_DOMAIN=cybericebox.example
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_PARTNER_ICE_NURE_URL=https://ice.nure.ua/ua/
NEXT_PUBLIC_PARTNER_NURE_URL=https://nure.ua
# Optional: Google Analytics 4 measurement id (empty = off).
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# Bot check: turnstile | recaptcha | none (none = local development). The site key is required unless none.
NEXT_PUBLIC_CAPTCHA_PROVIDER=none
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
# Optional, recaptcha only: Google Cloud project id (not secret). Non-empty = Enterprise, empty = classic v3.
NEXT_PUBLIC_RECAPTCHA_PROJECT=
# Dev only: comma list for allowedDevOrigins (default: the hosts above and *.<event domain>).
# DEV_ALLOWED_ORIGINS=
# Container listeners (nginx image only, runtime env, see README "Listeners and TLS"). All optional.
# HTTP_PORT=3000
# HTTPS_PORT=8443
# TLS_CERT_FILE=/tls/tls.crt
# TLS_KEY_FILE=/tls/tls.key
# TLS_MIN_VERSION=1.2
# TLS_CLIENT_CA_FILE=/ca/ca.crt
# TLS_CLIENT_AUTH=off
# HEALTH_PORT=
# TLS_RELOAD_INTERVAL=60
