# Copy to .env for local dev. All hosts are bare hosts (no scheme); no fallbacks, a missing one fails the build.
NEXT_PUBLIC_MAIN_HOST=cybericebox.example
NEXT_PUBLIC_API_HOST=api.cybericebox.example
NEXT_PUBLIC_ID_HOST=id.cybericebox.example
NEXT_PUBLIC_ADMIN_HOST=admin.cybericebox.example
NEXT_PUBLIC_EXERCISES_HOST=exercises.cybericebox.example
# Event sites are <tag>.<EVENT_DOMAIN>.
NEXT_PUBLIC_EVENT_DOMAIN=cybericebox.example
# Domain attribute of the shared theme/consent cookies.
NEXT_PUBLIC_COOKIE_DOMAIN=cybericebox.example
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_PARTNER_URL=https://ice.nure.ua/ua/
NEXT_PUBLIC_PARTNER_SITE_URL=https://nure.ua
# Optional: Google Analytics 4 measurement id (empty = off).
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# Bot check: turnstile | recaptcha | none (none = local development). The site key is required unless none.
NEXT_PUBLIC_CAPTCHA_PROVIDER=none
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
# recaptcha only: true for reCAPTCHA Enterprise.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE=false
# Dev only: comma list for allowedDevOrigins (default: the hosts above and *.<event domain>).
# DEV_ALLOWED_ORIGINS=
# Container listeners (nginx image only, runtime env, see README "Listeners and TLS"). All optional.
# HTTP_PORT=3000
# HTTPS_PORT=8443
# TLS_CERT_FILE=/tls/tls.crt
# TLS_KEY_FILE=/tls/tls.key
# TLS_MIN_VERSION=1.2
# TLS_CLIENT_CA_FILE=/ca/ca.crt
# TLS_CLIENT_AUTH=off
# HEALTH_PORT=
# TLS_RELOAD_INTERVAL=60
